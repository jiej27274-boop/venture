{
  "name": "venture-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "predev": "node scripts/sync-admin-style.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 5174",
    "prebuild": "node scripts/sync-admin-style.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 5174",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mysql:init": "node scripts/init-mysql.mjs",
    "admin:init": "node scripts/create-admin.mjs",
    "migrate:mysql": "node scripts/migrate-sqlite-to-mysql.mjs",
    "preflight": "node scripts/preflight.mjs",
    "test:domain": "pnpm --filter @venture/domain test"
  },
  "dependencies": {
    "@venture/domain": "workspace:*",
    "hono": "^4.7.0",
    "mysql2": "^3.14.3",
    "next": "^15.5.9",
    "nodemailer": "^7.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.1",
    "typescript": "^5.8.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
