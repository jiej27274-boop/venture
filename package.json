{
  "name": "venture-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:api": "pnpm --filter @venture/api dev",
    "dev:admin": "pnpm --filter @venture/admin dev",
    "dev:web": "pnpm --filter @venture/web dev",
    "start:api": "pnpm --filter @venture/api start",
    "preflight": "node scripts/preflight.mjs",
    "check:miniprogram": "node scripts/check-miniprogram.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
