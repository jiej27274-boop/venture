# Self-hosted MySQL configuration. Keep real values in the project-root .env
# or in the server's secret manager; never commit credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=venture
MYSQL_USER=venture
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10
# Optional alternative to the fields above, for example:
# MYSQL_URL=mysql://venture:password@127.0.0.1:3306/venture
# Used only by `pnpm admin:init`; keep the real password out of Git and rotate it after setup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_EMAIL_REQUIRED=false
AUTH_SECRET=replace-with-a-long-random-server-secret
APP_ORIGINS=http://127.0.0.1:5174

# Email OTP delivery. Use smtp on the server, preview with `pnpm dev` locally,
# or webhook when an internal mail service is already available. Production
# ignores preview and stays not-ready until smtp or webhook is configured.
EMAIL_PROVIDER=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
