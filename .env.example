# Local development configuration. Keep real values in the project-root .env or
# in the server provider's secret manager; never commit credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=venture-bp
SUPABASE_REQUIRE_EMAIL_OTP=false
AUTH_EMAIL_REQUIRED=false
APP_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

# The hosted Supabase project sends Auth OTP mail through its configured SMTP.
# The legacy preview/webhook delivery remains available for local fallback flows.
EMAIL_PROVIDER=preview
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
