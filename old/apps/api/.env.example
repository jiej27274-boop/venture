# Production API configuration
NODE_ENV=production
PORT=8787
VENTURE_DB_PATH=./data/venture.db
AUTH_SECRET=replace-with-a-long-random-secret
APP_ORIGINS=https://app.example.com,https://admin.example.com

# Set to true when every registration must include an email address.
AUTH_EMAIL_REQUIRED=false

# Development uses preview tokens. Production should use a mail service webhook.
EMAIL_PROVIDER=preview
# EMAIL_PROVIDER=webhook
# EMAIL_WEBHOOK_URL=https://your-mail-service.example/send
# EMAIL_WEBHOOK_TOKEN=replace-with-secret
