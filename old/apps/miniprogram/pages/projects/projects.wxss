.headline { padding: 28rpx 6rpx 38rpx; }.headline text { display: block; }.headline text:first-child { width: 620rpx; color: #1d1d1f; font-size: 48rpx; font-weight: 760; line-height: 1.16; letter-spacing: -2rpx; }.headline text:last-child { margin-top: 17rpx; color: #86868b; font-size: 23rpx; line-height: 1.55; }
.filters { white-space: nowrap; margin-bottom: 28rpx; }.filter { display: inline-flex; margin-right: 12rpx; padding: 14rpx 23rpx; border: 1rpx solid rgba(0,0,0,.05); border-radius: 99rpx; color: #6e6e73; background: rgba(255,255,255,.88); font-size: 21rpx; box-shadow: 0 6rpx 18rpx rgba(0,0,0,.035); }.filter.active { color: #fff; background: #1d1d1f; }
.result-count { margin: 11rpx 4rpx 20rpx; color: #86868b; font-size: 20rpx; }.project { margin-bottom: 24rpx; padding: 29rpx; }.project-top { display: flex; justify-content: space-between; align-items: center; gap: 18rpx; }.project-top > text:first-child { color: #1d1d1f; font-size: 31rpx; font-weight: 730; letter-spacing: -.5rpx; }.summary { display: block; margin-top: 18rpx; color: #6e6e73; font-size: 23rpx; line-height: 1.65; }.meta { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 22rpx; }.meta text { padding: 8rpx 13rpx; border-radius: 99rpx; background: #f0f0f3; color: #5f6368; font-size: 18rpx; }.funding { display: flex; justify-content: space-between; margin-top: 26rpx; padding-top: 21rpx; border-top: 1rpx solid rgba(0,0,0,.07); font-size: 21rpx; }.funding text:first-child { color: #86868b; }.funding text:last-child { color: #007f78; font-weight: 700; }
