<view class="page"><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{article}}" class="article-detail"><text class="tag">{{article.category}}</text><text class="title">{{article.title}}</text><text class="date">{{article.publishedAt}}</text><text class="lead">{{article.summary}}</text><text class="content">{{article.content}}</text><text class="disclaimer">本文仅供行业交流，不构成投资或招商承诺。</text></view></view>
