page { background: #eef7ff; }
.page { background: #eef7ff; }
.hero { position: relative; min-height: 390rpx; padding: 42rpx 34rpx 36rpx; border-radius: 38rpx; color: #17324a; background: radial-gradient(circle at 82% 28%,#e6f6ff,#c9e5f7 46%,#aed0eb 100%); overflow: hidden; box-shadow: 0 30rpx 70rpx rgba(46,104,141,.14); }
.hero-orb { position: absolute; width: 270rpx; height: 270rpx; right: -34rpx; top: 22rpx; border: 1rpx solid rgba(43,125,172,.2); border-radius: 50%; box-shadow: 0 0 0 28rpx rgba(255,255,255,.2), 0 0 0 58rpx rgba(85,180,225,.08); }
.hero-orb view { width: 144rpx; height: 144rpx; margin: 62rpx; border: 1rpx solid rgba(43,125,172,.22); border-radius: 50%; background: linear-gradient(145deg,rgba(255,255,255,.7),rgba(255,255,255,.18)); box-shadow: inset 0 2rpx rgba(255,255,255,.75),0 24rpx 70rpx rgba(46,146,201,.2); }
.eyebrow { position: relative; display: block; color: #34769c; font-size: 18rpx; font-weight: 700; letter-spacing: 3rpx; }
.hero-title { position: relative; display: block; width: 560rpx; margin-top: 26rpx; font-size: 50rpx; font-weight: 760; line-height: 1.18; letter-spacing: -2rpx; }
.hero-subtitle { position: relative; display: block; width: 470rpx; margin-top: 17rpx; color: #52728a; font-size: 23rpx; line-height: 1.55; }
.search { position: relative; margin-top: 30rpx; padding: 22rpx 25rpx; border: 1rpx solid rgba(43,125,172,.16); border-radius: 99rpx; color: #628198; background: rgba(255,255,255,.45); font-size: 23rpx; }
.role-grid { display: grid; grid-template-columns: repeat(4,1fr); margin-top: 34rpx; padding: 10rpx 4rpx; }
.role { display: flex; flex-direction: column; align-items: center; gap: 13rpx; color: #3a3a3c; font-size: 21rpx; font-weight: 650; }
.role-icon { width: 76rpx; height: 76rpx; display: grid; place-items: center; border-radius: 24rpx; color: #fff; font-size: 23rpx; font-weight: 750; box-shadow: inset 0 2rpx rgba(255,255,255,.28),0 10rpx 26rpx rgba(0,0,0,.1); }
.blue { background: linear-gradient(145deg,#6eb6ff,#2479df); }.green { background: linear-gradient(145deg,#6bdd9f,#28a968); }.gold { color: #3a310d; background: linear-gradient(145deg,#f8de81,#d9a728); }.teal { background: linear-gradient(145deg,#49d7c9,#078a82); }
.project-card { display: flex; margin-bottom: 24rpx; flex-direction: column; overflow: hidden; }
.project-accent { position: relative; width: 100%; height: 176rpx; background: radial-gradient(circle at 75% 25%,#80aaba,#244e60 42%,#0b202b); overflow: hidden; }
.project-accent view { position: absolute; width: 134rpx; height: 134rpx; right: 70rpx; top: 20rpx; border-radius: 42% 58% 62% 38%; background: linear-gradient(145deg,rgba(255,255,255,.7),rgba(255,255,255,.08)); box-shadow: inset -18rpx -18rpx 35rpx rgba(0,0,0,.16),0 22rpx 54rpx rgba(0,0,0,.22); transform: rotate(-16deg); }
.project-accent::after { content: ""; position: absolute; width: 210rpx; height: 210rpx; right: -30rpx; top: -42rpx; border: 1rpx solid rgba(255,255,255,.2); border-radius: 50%; box-shadow: 0 0 0 23rpx rgba(255,255,255,.035); }
.project-accent.accent-0 { background: radial-gradient(circle at 75% 25%,#aab7ff,#5b61bd 42%,#1a1b45); }.project-accent.accent-0 view { border-radius: 50%; transform: none; }
.project-accent.accent-2 { background: radial-gradient(circle at 75% 25%,#b1cf70,#417951 42%,#11291d); }.project-accent.accent-2 view { border-radius: 50% 50% 38% 62%; }
.project-body { flex: 1; padding: 27rpx 27rpx 29rpx; min-width: 0; }
.project-title-row { display: flex; justify-content: space-between; align-items: center; gap: 10rpx; color: #1d1d1f; font-size: 30rpx; font-weight: 730; }
.project-summary { display: -webkit-box; margin-top: 14rpx; overflow: hidden; color: #6e6e73; font-size: 23rpx; line-height: 1.6; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.project-meta { display: flex; gap: 10rpx; margin-top: 21rpx; }.project-meta text { padding: 8rpx 12rpx; border-radius: 99rpx; color: #5f6368; background: #f0f0f3; font-size: 18rpx; }
.contact-scroll { width: 100%; white-space: nowrap; }.contact-card { display: inline-flex; width: 370rpx; margin-right: 18rpx; padding: 27rpx; flex-direction: column; white-space: normal; vertical-align: top; }
.avatar { width: 72rpx; height: 72rpx; display: grid; place-items: center; border-radius: 50%; color: #fff; background: linear-gradient(145deg,#46d5c8,#078a82); font-weight: 750; box-shadow: 0 10rpx 26rpx rgba(0,127,120,.2); }
.contact-org { margin-top: 19rpx; color: #1d1d1f; font-size: 27rpx; font-weight: 720; }.contact-card .muted { margin-top: 9rpx; font-size: 21rpx; }.contact-region { margin-top: 18rpx; color: #007f78; font-size: 20rpx; font-weight: 650; }
