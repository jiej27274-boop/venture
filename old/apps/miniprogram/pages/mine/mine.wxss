.profile { display: flex; align-items: center; gap: 20rpx; padding: 30rpx; }.avatar { width: 86rpx; height: 86rpx; display: grid; place-items: center; border-radius: 50%; color: #fff; background: linear-gradient(145deg,#43d2c5,#078a82); box-shadow: 0 12rpx 28rpx rgba(0,127,120,.2); font-size: 31rpx; font-weight: 750; }.name,.verified { display: block; }.name { color: #1d1d1f; font-size: 30rpx; font-weight: 730; }.verified { margin-top: 8rpx; color: #007f78; font-size: 20rpx; }.switch { margin-left: auto; padding: 9rpx 15rpx; border-radius: 99rpx; color: #007f78; background: #e2f5f2; font-size: 21rpx; font-weight: 650; }.stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 14rpx; margin-top: 22rpx; }.stats view { padding: 26rpx 10rpx; text-align: center; }.stats text { display: block; }.stats text:first-child { color: #1d1d1f; font-size: 39rpx; font-weight: 760; }.stats text:last-child { margin-top: 8rpx; color: #86868b; font-size: 19rpx; }.menu { margin-top: 22rpx; padding: 0 28rpx; }.menu view { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid rgba(0,0,0,.07); }.menu view:last-child { border: 0; }.menu text:first-child { color: #1d1d1f; font-size: 25rpx; font-weight: 650; }.menu text:last-child { color: #86868b; font-size: 19rpx; }.security { margin-top: 22rpx; padding: 28rpx; }.security text { display: block; }.security text:first-child { color: #007f78; font-size: 24rpx; font-weight: 700; }.security text:last-child { margin-top: 12rpx; color: #6e6e73; font-size: 21rpx; line-height: 1.65; }
