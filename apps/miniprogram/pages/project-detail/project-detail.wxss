.project-hero { position: relative; padding: 34rpx 31rpx; overflow: hidden; }.project-hero::before { content: ""; position: absolute; width: 220rpx; height: 220rpx; right: -70rpx; top: -80rpx; border-radius: 50%; background: radial-gradient(circle,#73d9d0,rgba(115,217,208,0)); opacity: .24; }.hero-top { position: relative; display: flex; justify-content: space-between; }.bp-state { color: #007f78; font-size: 21rpx; font-weight: 650; }.title { position: relative; display: block; margin-top: 31rpx; color: #1d1d1f; font-size: 46rpx; font-weight: 760; line-height: 1.18; letter-spacing: -2rpx; }.summary { position: relative; display: block; margin-top: 19rpx; color: #6e6e73; font-size: 24rpx; line-height: 1.7; }.meta { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 25rpx; }.meta text { padding: 9rpx 14rpx; border-radius: 99rpx; color: #5f6368; background: #f0f0f3; font-size: 19rpx; }.section { margin-top: 22rpx; padding: 30rpx; color: #6e6e73; font-size: 23rpx; line-height: 1.7; }.section-title { display: block; margin-bottom: 18rpx; color: #1d1d1f; font-size: 30rpx; font-weight: 730; }.rule { display: grid; grid-template-columns: 110rpx 1fr; gap: 16rpx; padding: 19rpx 0; border-top: 1rpx solid rgba(0,0,0,.07); }.rule text:first-child { color: #007f78; font-weight: 700; }.notice { margin: 24rpx 0; padding: 21rpx; border-radius: 18rpx; color: #007f78; background: #e2f5f2; font-size: 22rpx; text-align: center; }.button-primary { margin-top: 28rpx; }
