.headline { padding: 28rpx 6rpx 38rpx; }.headline text { display: block; }.headline text:first-child { width: 620rpx; color: #1d1d1f; font-size: 47rpx; font-weight: 760; line-height: 1.16; letter-spacing: -2rpx; }.headline text:last-child { margin-top: 17rpx; color: #86868b; font-size: 23rpx; line-height: 1.55; }
.filters { white-space: nowrap; margin-bottom: 26rpx; }.filter { display: inline-flex; margin-right: 12rpx; padding: 14rpx 23rpx; border-radius: 99rpx; color: #6e6e73; background: #fff; font-size: 21rpx; box-shadow: 0 7rpx 20rpx rgba(0,0,0,.04); }.filter.active { color: #fff; background: #1d1d1f; }
.contact { display: flex; gap: 22rpx; margin-bottom: 24rpx; padding: 28rpx; }.avatar { flex: 0 0 auto; width: 82rpx; height: 82rpx; display: grid; place-items: center; border-radius: 50%; color: #fff; background: linear-gradient(145deg,#47d4c8,#078a82); box-shadow: 0 11rpx 26rpx rgba(0,127,120,.2); font-size: 30rpx; font-weight: 750; }.contact-body { flex: 1; min-width: 0; }.org-row { display: flex; justify-content: space-between; align-items: center; gap: 14rpx; }.org-row > text:first-child { color: #1d1d1f; font-size: 29rpx; font-weight: 720; }.contact-body > .muted,.region { display: block; margin-top: 12rpx; font-size: 21rpx; }.region { color: #007f78; font-weight: 650; }.industries { display: flex; flex-wrap: wrap; gap: 9rpx; margin-top: 18rpx; }.industries text { padding: 7rpx 12rpx; border-radius: 99rpx; color: #5f6368; background: #f0f0f3; font-size: 18rpx; }.contact button { margin: 22rpx 0 0; color: #fff; border: 0; border-radius: 99rpx; background: #007f78; font-size: 22rpx; font-weight: 650; }.contact button::after { border: 0; }
